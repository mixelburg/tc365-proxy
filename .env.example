# tc365-bot configuration — copy to .env (gitignored) or export in PM2 env.

# ── Required ──────────────────────────────────────────────────────────
# Dedicated Telegram bot token from @BotFather. MUST be a fresh bot that no
# other process polls (a Hermes gateway token will 409-conflict).
# TC_BOT_TOKEN=123456789:AA...

# Encryption key for stored credentials (AES-256-GCM). Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TC_ENC_KEY=change-me-to-a-long-random-hex-string

# ── Optional ──────────────────────────────────────────────────────────
# Chat id allowed to run admin commands (/users, /remove). Defaults to the
# migrated legacy account's chat (or the first registered user).
# TC_ADMIN_CHAT=6313947459

# Ping fallback token/chat when TC_BOT_TOKEN isn't set yet (v2 compat):
# TC_TG_BOT_TOKEN=...
# TC_TG_CHAT_ID=...

# HTTP server
# PORT=8787
# HOST=127.0.0.1
# TC_PROXY_KEY=optional-x-api-key-gate

# Scheduling defaults (new registrations inherit these; each user can
# override via the bot: /hour, /schedule, /holidays)
# TC_SCHED_PUNCH_HOUR=9
# TC_SCHED_JITTER_MIN=30
# TC_SCHED_MIN_HOURS=8
# TC_SCHED_MAX_HOURS=10
# TC_SCHED_DAILY=mon:OFFICE,tue:OFFICE,wed:HOME,thu:OFFICE,sun:HOME
# TC_SKIP_HOLIDAYS=true
# TC_HOLIDAY_EXTRA=Atzma,Sigd
# TC_TZ=Asia/Jerusalem

# File locations (defaults live next to the repo root)
# TC_USERS_FILE=/home/ubuntu/tc365-proxy/users.json
# TC_SCHED_STATE=/home/ubuntu/tc365-proxy/scheduler-state.json
# TC_HOLIDAY_CACHE=/home/ubuntu/tc365-proxy/holiday-cache.json
