# tc365-proxy configuration
# Copy to .env or export in the PM2 ecosystem file.

# Where to listen (default 127.0.0.1:8787). Use HOST=0.0.0.0 to expose on LAN.
# PORT=8787
# HOST=127.0.0.1

# Optional: preconfigured TimeClock 365 credentials (mints tokens on demand).
# Leave empty and POST /auth/login instead.
# TC_USERNAME=you@company.com
# TC_PASSWORD=yourpassword

# Optional: require this key in the x-api-key header on every route
# (recommended if you set HOST=0.0.0.0 or expose via tunnel).
# TC_PROXY_KEY=change-me

# Optional: override token state file location
# TC_STATE_FILE=/home/ubuntu/tc365-proxy/state.json

# --- Scheduler (tc365-scheduler) ---
# Israeli holidays are skipped automatically (Hebcal yomtov days plus
# Yom Ha'Atzma'ut and Sigd). Toggle / tune here:
# TC_SKIP_HOLIDAYS=true        # set false to punch on holidays too
# TC_HOLIDAY_EXTRA=Atzma,Sigd  # extra Hebcal titles to treat as days off
#                              # (add CH''M to also skip chol hamoed)
# TC_HOLIDAY_CACHE=/home/ubuntu/tc365-proxy/holiday-cache.json
